# Copy to .env and fill in. Never commit .env.
# Used only the first time the database is created; change later with `npm run admin:password`.
ADMIN_PASSWORD=change-me-to-something-long

# Port for the store + API (default 8787). Hosts usually inject their own PORT.
PORT=8787

# Interface to bind (default 127.0.0.1). Use 0.0.0.0 in a container or on a PaaS.
# HOST=0.0.0.0

# Where the database, session secret and uploads live (default ./data).
# Point this at the mounted disk on a host: DATA_DIR=/data
# DATA_DIR=/data

# Trusted proxy hops. Set to 1 when a TLS proxy sits in front (Render, Railway,
# Fly), so req.secure works and the Origin check sees https instead of http.
# TRUST_PROXY=1

# Set to 1 only when serving over HTTPS, so the admin cookie is Secure.
COOKIE_SECURE=0

# Optional: pin the cookie signing key. Generated into data/session-secret if absent.
# SESSION_SECRET=

# Optional: only needed if the site sits behind a different public origin.
# APP_ORIGIN=https://falaise.example
