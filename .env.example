# Copy to .env and fill in. Never commit .env.
# Used only the first time the database is created; change later with `npm run admin:password`.
ADMIN_PASSWORD=change-me-to-something-long

# Port for the store + API (default 8787).
PORT=8787

# Set to 1 only when serving over HTTPS, so the admin cookie is Secure.
COOKIE_SECURE=0

# Optional: pin the cookie signing key. Generated into data/session-secret if absent.
# SESSION_SECRET=

# Optional: only needed if the site sits behind a different public origin.
# APP_ORIGIN=https://falaise.example
